# Environment Variables for Kdenlive Headless Container

# API key for authentication between Hermes and Kdenlive API
# Generate a secure key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KDENLIVE_API_KEY=CHANGE_ME_TO_SECURE_RANDOM_KEY

# Timezone for consistent timestamps
TZ=Asia/Kolkata

# Optional: Override workspace path if needed
# KDENLIVE_WORKSPACE_PATH=/workspace